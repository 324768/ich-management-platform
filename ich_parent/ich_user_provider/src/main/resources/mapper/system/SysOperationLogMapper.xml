<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hyang.ich.user.mapper.system.SysOperationLogMapper">

    <resultMap id="BaseResultMap" type="com.hyang.ich.user.entity.SysOperationLog">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="username" property="username"/>
        <result column="module" property="module"/>
        <result column="operation" property="operation"/>
        <result column="method" property="method"/>
        <result column="request_method" property="requestMethod"/>
        <result column="request_uri" property="requestUri"/>
        <result column="ip" property="ip"/>
        <result column="status" property="status"/>
        <result column="error_msg" property="errorMsg"/>
        <result column="execute_time" property="executeTime"/>
        <result column="operation_time" property="operationTime"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Brief_Columns">
        id, user_id, username, module, operation, method,
        request_method, request_uri, ip, status, error_msg,
        execute_time, operation_time, create_time
    </sql>

    <select id="selectByCondition" resultMap="BaseResultMap">
        SELECT <include refid="Brief_Columns"/>
        FROM sys_operation_log
        WHERE is_deleted = 0
        <if test="userId != null">AND user_id = #{userId}</if>
        <if test="module != null and module != ''">AND module = #{module}</if>
        ORDER BY operation_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countByCondition" resultType="int">
        SELECT COUNT(*) FROM sys_operation_log
        WHERE is_deleted = 0
        <if test="userId != null">AND user_id = #{userId}</if>
        <if test="module != null and module != ''">AND module = #{module}</if>
    </select>

    <select id="selectUserRecentOps" resultMap="BaseResultMap">
        SELECT <include refid="Brief_Columns"/>
        FROM sys_operation_log
        WHERE is_deleted = 0 AND user_id = #{userId}
        ORDER BY operation_time DESC
        LIMIT #{limit}
    </select>

    <select id="selectFailedOps" resultMap="BaseResultMap">
        SELECT <include refid="Brief_Columns"/>
        FROM sys_operation_log
        WHERE is_deleted = 0 AND status = 1
        AND operation_time >= DATE_SUB(NOW(), INTERVAL #{hours} HOUR)
        ORDER BY operation_time DESC
        LIMIT #{limit}
    </select>

    <select id="countTodayOps" resultType="int">
        SELECT COUNT(*) FROM sys_operation_log
        WHERE is_deleted = 0
        AND DATE(operation_time) = CURDATE()
    </select>
</mapper>
